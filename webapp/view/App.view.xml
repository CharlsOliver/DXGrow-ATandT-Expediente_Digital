<mvc:View controllerName="btpexpedientedigital.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <!-- Header Standalone (full width) -->
    <VBox id="standaloneHeader" visible="true">
        <HBox class="customHeaderBox">

            <!-- Agrupamos logo + título -->
            <HBox alignItems="Center">
                <Image
                    src="assets/logo.png"
                    class="headerLogo"
                />
                <Text id="headerTitle" class="customHeaderText" text="Nombre" />
            </HBox>

            <!-- Código se queda a la derecha -->
            <Text id="headerCode"
                text="# Usuario"
                class="customHeaderText"/>
        </HBox>
    </VBox>

    <!-- Contenedor tipo Launchpad SOLO para la app -->
    <VBox class="customContainer">
        <App id="app" />
    </VBox>

</mvc:View>