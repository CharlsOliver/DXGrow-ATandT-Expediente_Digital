<mvc:View
    controllerName="btpexpedientedigital.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <!-- Header Standalone (full width) -->
    <VBox id="standaloneHeader" visible="true">
        <HBox class="customHeaderBox">

            <!-- Logo + nombre del usuario -->
            <HBox alignItems="Center">
                <Image
                    src="assets/logo.png"
                    class="headerLogo"
                />

                <Title
                    id="headerTitle"
                    text="{= ${User>/name} + ' ' + ${User>/lastname} }"
                />
            </HBox>

            <!-- Número de empleado -->
            <Text
                id="headerCode"
                text="{=${User>/userId} }"
                class="customHeaderRight"
            />

        </HBox>
    </VBox>

    <!-- Contenedor tipo Launchpad SOLO para la app -->
    <VBox class="customContainer">
        <App id="app" />
    </VBox>

</mvc:View>