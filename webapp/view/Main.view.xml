<mvc:View controllerName="btpexpedientedigital.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Panel
            headerText="Selección de usuarios"
            class="sapUiMediumMarginTop sapUiMediumMarginBottom"
            width="auto">
            <content>
                <Input
                    placeholder="Ingrese nombre o ID de usuario"
                    showSuggestion="true"
                    class="sapUiSmallMarginTop"
                    suggest=".onSuggest"
                    width="60%"
                    suggestionItemSelected=".onSuggestionItemSelected"
                    suggestionItems="{
                        path: 'SFSF>/User',
                        length: 10,
                        parameters: {
                            select: 'userId,firstName,lastName,title,email'
                        }
                    }">
                    <suggestionItems>
                        <core:ListItem
                            text="{SFSF>firstName} {SFSF>lastName}"
                            additionalText="{SFSF>userId}"
                        />
                    </suggestionItems>
                </Input>
                <Button
                    id="helloDialogButton"
                    text="Agregar"
                    press=".onAgregarUsuario"
                    class="sapUiSmallMargin"
                />
            </content>
        </Panel>

        <Panel>
            <Table
                id="invoiceList"
                width="auto"
                items="{UsuariosTable>/}">
                <headerToolbar>
                    <Toolbar>
                        <Title
                            text="Usuarios"
                            level="H2"
                        />
                        <ToolbarSpacer />
                        <Button
                            icon="sap-icon://play"
                            text="Ejecutar todo"
                            type="Emphasized"
                            press=".onAddPress"
                        />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="No. Empleado" />
                    </Column>
                    <Column>
                        <Text text="Nombre" />
                    </Column>
                    <Column>
                        <Text text="Apellido" />
                    </Column>
                    <Column>
                        <Text text="Estatus" />
                    </Column>
                    <Column>
                        <Text text="Acciones" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem
                        press=".onPress"
                        type="Navigation">
                        <cells>
                            <Text text="{UsuariosTable>userId}" />
                            <Text text="{UsuariosTable>firstName}" />
                            <Text text="{UsuariosTable>lastName}" />
                            <ObjectStatus
                                text="{UsuariosTable>status}"
                                state="None"
                            />
                            <HBox>
                                <Button
                                    icon="sap-icon://play"
                                    class="sapUiTinyMarginEnd"
                                    press=".onExecutePress"
                                />
                                <Button
                                    icon="sap-icon://delete"
                                    class="sapUiTinyMarginEnd"
                                    type="Reject"
                                    press=".onDeletePress"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>
    </Page>
</mvc:View>