<mvc:View controllerName="btpexpedientedigital.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Panel
            headerText="Selección de usuarios"
            class="sapUiMediumMarginTop sapUiMediumMarginBottom"
            width="auto">
            <content>
                <Input
                    id="inptBuscarUsuario"
                    placeholder="Ingrese nombre o ID de usuario"
                    showSuggestion="true"
                    class="sapUiSmallMarginTop"
                    suggest=".onSuggest"
                    width="60%"
                    suggestionItemSelected=".onSuggestionItemSelected"
                    suggestionItems="{
                        path: 'SFSF>/User',
                        length: 10,
                        parameters: {
                            select: 'userId,firstName,lastName,title,email'
                        }
                    }">
                    <suggestionItems>
                        <core:ListItem
                            text="{SFSF>firstName} {SFSF>lastName}"
                            additionalText="{SFSF>userId}"
                        />
                    </suggestionItems>
                </Input>
                <Button
                    id="helloDialogButton"
                    text="Agregar"
                    press=".onAgregarUsuario"
                    class="sapUiSmallMargin"
                />
            </content>
        </Panel>

        <Panel>
            <Table
                id="expedienteTable"
                width="auto"
                growingThreshold="20"
                growingScrollToLoad="true"
                items="{
                    path: 'SFSF>/cust_EmployeeFile_Request',
                    parameters: {
                        select: 'externalCode,cust_userId,cust_status,cust_progressPercent,cust_jobId'
                    }
                }">
                <headerToolbar>
                    <Toolbar>
                        <Title
                            text="Usuarios"
                            level="H2"
                        />
                        <ToolbarSpacer />

                        <Button
                            icon="sap-icon://play"
                            visible="false"
                            text="Ejecutar todo"
                            type="Emphasized"
                            press=".onExcecuteAll"
                        />
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="No. Empleado" />
                    </Column>
                    <Column>
                        <Text text="Nombre" />
                    </Column>
                    <Column>
                        <Text text="Apellido" />
                    </Column>
                    <Column>
                        <Text text="Estatus" />
                    </Column>
                    <Column>
                        <Text text="Avance" />
                    </Column>
                    <Column>
                        <Text text="Acciones" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{SFSF>externalCode}" />
                            <Text text="" />
                            <Text text="" />
                            <ObjectStatus
                                text="{SFSF>cust_status}"
                                state="None"
                            />
                            <HBox alignItems="Center">
                                <ObjectNumber
                                    number="{SFSF>cust_progressPercent}"
                                    unit="%"
                                    state="{
                                        path: 'SFSF>cust_progressPercent',
                                        formatter: '.formatter.percentState'
                                    }"
                                />
                            </HBox>
                            <HBox>
                                <Button
                                    icon="sap-icon://play"
                                    class="sapUiTinyMarginEnd"
                                    press=".onExecutePress"
                                />
                                <Button
                                    icon="sap-icon://delete"
                                    class="sapUiTinyMarginEnd"
                                    type="Reject"
                                    press=".onDeletePress"
                                />
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>
    </Page>
</mvc:View>