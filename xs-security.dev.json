{
  "xsappname": "btpexpedientedigital",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.*.hana.ondemand.com/**"
    ],
    "grant-types": [
      "authorization_code"
    ],
    "allowedIdentityProviders": [
      "sap.custom"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.Display",
      "description": "Display scope"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "Viewer role",
      "scope-references": [
        "$XSAPPNAME.Display"
      ]
    }
  ]
}